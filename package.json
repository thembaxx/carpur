{
  "name": "carpur",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "oxlint --deny-warnings src scripts",
    "typecheck": "tsc --noEmit",
    "parity:shell": "node scripts/parity.mjs --shell",
    "check:shell": "node scripts/check-shell.mjs",
    "parity:studio": "node scripts/parity.mjs --studio",
    "check:studio": "node scripts/check-studio.mjs",
    "parity:marketplace": "node scripts/parity.mjs --marketplace",
    "check:marketplace": "node scripts/check-marketplace.mjs",
    "parity:ownership": "node scripts/parity.mjs --ownership",
    "check:ownership": "node scripts/check-ownership.mjs",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "pixelmatch": "^8",
    "playwright": "^1.64",
    "pngjs": "^7",
    "typescript": "^7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
